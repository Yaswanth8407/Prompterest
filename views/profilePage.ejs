<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prompterest — Sandesh Narkar</title>
    <script>
      (function () {
        let s;
        try {
          s = localStorage.getItem("prest-theme");
        } catch (_) {}
        const dark = s
          ? s === "dark"
          : window.matchMedia("(prefers-color-scheme:dark)").matches;
        document.documentElement.setAttribute(
          "data-theme",
          dark ? "dark" : "light",
        );
      })();
    </script>
    <link rel="stylesheet" href="/stylesheets/profilePage.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <aside id="sidebar">
      <div class="logo">P</div>
      <nav class="sidebar-nav">
        <a class="nav-icon active" href="/feed" data-tip="Home">
          <span
            class="material-symbols-outlined"
            style="font-variation-settings: &quot;FILL&quot; 1"
            >home</span
          >
          <span class="nav-label">Home</span>
        </a>
        <a class="nav-icon" href="#" data-tip="Explore">
          <span class="material-symbols-outlined">explore</span>
          <span class="nav-label">Explore</span>
        </a>
        <a class="nav-icon" href="/addPost" data-tip="Create">
          <span class="material-symbols-outlined">add_circle</span>
          <span class="nav-label">Create</span>
        </a>
        <a class="nav-icon" href="#" data-tip="Saved">
          <span class="material-symbols-outlined">bookmark</span>
          <span class="nav-label">Saved</span>
        </a>
        <a class="nav-icon" href="#" data-tip="Notifications">
          <span class="material-symbols-outlined">notifications</span>
          <span class="nav-label">Alerts</span>
        </a>
        <a class="nav-icon" href="#" data-tip="Messages">
          <span class="material-symbols-outlined">chat</span>
          <span class="nav-label">Messages</span>
        </a>
        <a class="nav-icon" href="#" data-tip="Trending">
          <span class="material-symbols-outlined">trending_up</span>
          <span class="nav-label">Trending</span>
        </a>
        <a class="nav-icon" href="#" data-tip="Profile">
          <span class="material-symbols-outlined">person</span>
          <span class="nav-label">Profile</span>
        </a>
      </nav>
      <div class="sidebar-bottom">
        <a class="nav-icon" href="#" data-tip="Settings">
          <span class="material-symbols-outlined">settings</span>
          <span class="nav-label">Settings</span>
        </a>
        <a class="nav-icon" href="#" data-tip="Help">
          <span class="material-symbols-outlined">help_outline</span>
          <span class="nav-label">Help</span>
        </a>
      </div>
    </aside>

    <header id="header">
      <div class="header-left">
        <h1 class="header-logo">Prompterest</h1>
        <div class="search-wrap">
          <span class="material-symbols-outlined search-icon">search</span>
          <input
            class="search-input"
            type="text"
            placeholder="Search AI prompts, artists, or styles…"
            aria-label="Search"
          />
        </div>
      </div>
      <div class="header-right">
        <button
          class="toggle-track"
          id="themeToggle"
          aria-label="Toggle dark/light mode"
        >
          <span
            class="toggle-star"
            style="width: 3px; height: 3px; top: 5px; left: 13px"
          ></span>
          <span
            class="toggle-star"
            style="width: 2px; height: 2px; top: 15px; left: 20px"
          ></span>
          <span
            class="toggle-star"
            style="width: 2px; height: 2px; top: 7px; left: 32px"
          ></span>
          <div class="toggle-knob">
            <span class="material-symbols-outlined" id="toggle-icon"
              >dark_mode</span
            >
          </div>
        </button>
        <button class="icon-btn" aria-label="Notifications">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="icon-btn" aria-label="AI Tools">
          <span class="material-symbols-outlined">psychology</span>
        </button>
        <img
          class="header-avatar"
          src="https://media.licdn.com/dms/image/v2/D4D03AQEgCuuhRC7DvA/profile-displayphoto-scale_400_400/B4DZ2ve7N1GcAg-/0/1776765615153?e=1781740800&v=beta&t=_HD73K4Ckp8WeqW0nPdXlExxqzFIh7iPOjUt6Dfm99I"
          alt="User avatar"
        />
      </div>
    </header>

    <main class="main-content">
      <section class="profile-section">
        <div class="banner">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDVKLRYasXAHtwS356MTrPQhULX0lpA4ANLwnpaMQXw_cZb9AehteZ9YrZlmceZbSY163bZjsBYrfS-ETWBDVoKAP8DyRjqOu5uzmSc-boj39TgvXVrCpZ2Cq0UtHJXXtspmQzUzK6NhzmxAu1BpGnLA2vPlgxqLyvuzUKNq7xjRxLGdMf0hAU1LigzM2TG7EEBLSPszkKGDumyVFU387fcAjv52_PnTLm6vrs5X3TjB1ZgewCMnR5qta01lvxEH_zBxW-mJpHmRaFp"
            alt="Profile banner"
          />
        </div>
        <div class="profile-card-wrap">
          <div class="profile-card glass-panel">
            <div class="profile-left">
              <div class="profile-avatar-wrap">
                <div class="profile-avatar">
                  <img src="" alt="Profile" />
                </div>
                <div class="online-dot"></div>
              </div>
              <div class="profile-bio">
                <h1 class="profile-name"><%= foundCredentials.fullname %></h1>
                <p class="profile-handle"><%= foundCredentials.username %></p>
                <div class="profile-tags">
                  <span class="badge-role">AI Artist &amp; Designer</span>
                  <span class="profile-location">
                    <span
                      class="material-symbols-outlined"
                      style="font-size: 15px"
                      >location_on</span
                    >
                    San Francisco
                  </span>
                </div>
                <p class="profile-desc">
                  Architecting the future of AI prompts. UI/UX enthusiast.
                  Passionate about merging human creativity with machine
                  intelligence.
                </p>
              </div>
            </div>
            <div class="profile-right">
              <div class="profile-actions">
                <button class="btn-follow" id="followBtn">Follow</button>
                <button class="btn-message">Message</button>
                <button class="btn-icon-action">
                  <span class="material-symbols-outlined">edit</span>
                </button>
              </div>
              <div class="profile-stats">
                <div class="stat">
                  <p class="stat-num">12.4k</p>
                  <p class="stat-label">Followers</p>
                </div>
                <div class="stat">
                  <p class="stat-num">842</p>
                  <p class="stat-label">Following</p>
                </div>
                <div class="stat">
                  <p class="stat-num">156</p>
                  <p class="stat-label">Prompts</p>
                </div>
                <div class="stat">
                  <p class="stat-num">12</p>
                  <p class="stat-label">Collections</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <nav class="tabs-nav" id="tabs-nav">
        <div class="tabs-inner">
          <a class="tab-link active" href="#" data-tab="posts">Posts</a>
          <a class="tab-link" href="#" data-tab="saved">Saved</a>
          <a class="tab-link" href="#" data-tab="collections">Collections</a>
          <a class="tab-link" href="#" data-tab="liked">Liked</a>
          <a class="tab-link" href="#" data-tab="about">About</a>
        </div>
      </nav>

