<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Profile</title>
  <link rel="stylesheet" href="/stylesheets/EditProfile.css" />
</head>

<body>
  <form
    class="card"
    action="/editprofile"
    method="POST"
    enctype="multipart/form-data"
  >
    <h1>Edit Profile</h1>

    <label class="theme-switch">
      <input type="checkbox" id="themeToggle" />
      <span class="slider"></span>
    </label>

    <div class="avatar-row">
      <img
        id="avatarPreview"
        class="avatar"
        src="<%= foundCredentials.profilepic || '/images/default-avatar.png' %>"
        alt="Profile photo"
      />

      <label for="profilePic" class="avatar-placeholder">
        +
      </label>

      <input
        id="profilePic"
        name="profilepic"
        type="file"
        accept="image/*"
        hidden
      />
    </div>

    <div class="form-grid">
      <div class="field">
        <label>Full Name</label>
        <input
          type="text"
          name="fullname"
          value="<%= foundCredentials.fullname %>"
        />
      </div>

      <div class="field">
        <label>Username</label>

        <div class="input-prefix">
          <span>@</span>

          <input
            type="text"
            name="username"
            value="<%= foundCredentials.username %>"
          />
        </div>
      </div>

      <div class="field full">
        <div class="label-row">
          <label>Bio</label>

          <span class="char-count" id="charCount">
            <%= (foundCredentials.bio || '').length %> / 160
          </span>
        </div>

        <textarea
          id="bio"
          name="bio"
          maxlength="160"
        ><%= foundCredentials.bio || '' %></textarea>
      </div>

      <div class="field">
        <label>Birthday Date</label>

        <input
          type="date"
          name="birthday"
          value="<%= foundCredentials.birthday || '' %>"
        />
      </div>

      <div class="field">
        <label>Gender</label>

        <select name="gender">
          <option value="">Select</option>

          <option
            value="male"
            <%= foundCredentials.gender === 'male' ? 'selected' : '' %>
          >
            Male
          </option>

          <option
            value="female"
            <%= foundCredentials.gender === 'female' ? 'selected' : '' %>
          >
            Female
          </option>

          <option
            value="other"
            <%= foundCredentials.gender === 'other' ? 'selected' : '' %>
          >
            Other
          </option>

          <option
            value="prefer_not"
            <%= foundCredentials.gender === 'prefer_not' ? 'selected' : '' %>
          >
            Prefer not to say
          </option>
        </select>
      </div>

      <div class="field full">
        <label>Email</label>

        <input
          type="email"
          disabled
          value="<%= foundCredentials.email %>"
        />
      </div>
    </div>

    <div class="actions">
      <button
        type="button"
        class="btn btn-cancel"
        onclick="window.location.href='/profile'"
      >
        Cancel
      </button>

      <button
        type="submit"
        class="btn btn-save"
      >
        Save Changes
      </button>
    </div>
  </form>

  <script>
    const toggle = document.getElementById("themeToggle");
    const bio = document.getElementById("bio");
    const charCount = document.getElementById("charCount");
    const profilePicInput = document.getElementById("profilePic");
    const avatarPreview = document.getElementById("avatarPreview");

    // Theme Toggle
    document.documentElement.setAttribute("data-theme", "dark");

    toggle.addEventListener("change", () => {
      document.documentElement.setAttribute(
        "data-theme",
        toggle.checked ? "light" : "dark"
      );
    });

    // Bio Counter
    bio.addEventListener("input", () => {
      charCount.textContent =
        `${bio.value.length} / 160`;
    });

    // Image Preview Before Save
    profilePicInput.addEventListener("change", function () {
      const file = this.files[0];

      if (!file) return;

      if (!file.type.startsWith("image/")) {
        alert("Please select an image file.");
        this.value = "";
        return;
      }

      const imageURL = URL.createObjectURL(file);

      avatarPreview.onload = () => {
        URL.revokeObjectURL(imageURL);
      };

      avatarPreview.src = imageURL;
    });
  </script>
</body>
</html>